# =====================================================================
# VISL EBITDA Drive PMO - environment
# Copy to .env and edit. Never commit .env.
# =====================================================================
#
# !! READ THIS BEFORE SETTING ANY PASSWORD !!
#
# dotenv truncates an unquoted value at a '#' character. In the ESL
# deployment this silently shortened the database password and produced a
# "login failed" that looked like wrong credentials for half a day, and
# then did the same thing to the bootstrap admin password.
#
# Keep every secret in this file to letters, digits, hyphen and underscore.
# Avoid  #  $  ;  !  and quote characters entirely.
# =====================================================================

NODE_ENV=development
PORT=4010
APP_URL=http://localhost:4010
APP_NAME=VISL EBITDA Drive PMO


# ---------------------------------------------------------------------
# DATA SOURCE
# ---------------------------------------------------------------------
# synthetic - deterministic in-memory dataset, no database required.
#             Writes are real and persist to var/state.json.
#             Use this for design review and demonstrations.
# mssql     - SQL Server (on-premise) or Azure SQL. Run sql/00 once, then 01..04.
#
# This is the only line that changes when you connect the database.
DATA_MODE=synthetic


# ---------------------------------------------------------------------
# DATABASE  (required when DATA_MODE=mssql)
# ---------------------------------------------------------------------
# The server name exactly as used in SSMS "Server name", without the
# instance part. Examples:  SQLPRD01.vedanta.local   10.20.30.40
DB_HOST=sqlserver.example.local
# Named instance (SSMS shows SERVERINSTANCE)? Put the instance here and
# DB_PORT is ignored (SQL Browser, UDP 1434, resolves it). Blank = default instance.
DB_INSTANCE=
DB_PORT=1433
DB_NAME=VISL_PMO

# sql  - SQL Server login (recommended): DB_USER / DB_PASSWORD, e.g. visl_app
# ntlm - Windows domain service account: DB_DOMAIN + DB_USER / DB_PASSWORD
DB_AUTH=sql
DB_DOMAIN=
# The RUNTIME login - db_datareader + db_datawriter only (sql/00_server_setup.sql).
# Use visl_owner only while running `npm run migrate`, then switch back.
DB_USER=visl_app
DB_PASSWORD=change_me_no_hash_or_dollar

# Encryption. Azure SQL: true / false. On-premise with the company CA-issued
# certificate: true / false. On-premise with a self-signed certificate
# (common on internal servers): true / true.
DB_ENCRYPT=true
DB_TRUST_SERVER_CERT=false

# Serverless Azure tiers auto-pause when idle. The first query after a quiet
# period takes 30-60 seconds to resume, so these are deliberately generous.
# Open the application ~15 minutes before any demonstration.
DB_REQUEST_TIMEOUT_MS=90000
DB_CONNECT_TIMEOUT_MS=60000
DB_POOL_MAX=10


# ---------------------------------------------------------------------
# AUTHENTICATION
# ---------------------------------------------------------------------
# local  - every account signs in with a password stored (bcrypt) in dbo.users
# ad     - only Active Directory accounts can sign in
# hybrid - AD accounts via the directory, local accounts via their password.
#          RECOMMENDED for go-live: keeps a break-glass local administrator
#          for when the directory is unreachable.
# Each user is marked AD or Local under Administration > Users & roles.
AUTH_MODE=local

# MUST be changed before production. The application refuses to start in
# production with the development default.
JWT_SECRET=dev-only-secret-change-me
SESSION_HOURS=10
COOKIE_NAME=visl_pmo_sid
# Set true once the application is served over HTTPS.
COOKIE_SECURE=false


# ---------------------------------------------------------------------
# ACTIVE DIRECTORY over LDAP  (AUTH_MODE=ad or hybrid)
# ---------------------------------------------------------------------
# VISL has TWO directories (forests):
#     ESL  - serves ESL
#     IOB  - serves IOB (IOK, IOG, VAB, HO) and FACOR
# Each user signs in against the directory that serves their home business
# unit. Group-level users (home unit VISL) are tried against both, in order.
#
# What to request from each directory's AD team, and what every value means:
# HANDOVER.txt section 9. Test each directory before go-live with:
#     npm run ad:test -- --dir ESL --user <an.esl.user> --password
#     npm run ad:test -- --dir IOB --user <an.iob.user> --password
#
AD_DIRS=ESL,IOB

# --- ESL directory --------------------------------------------------
# Domain controller over LDAPS (TCP 636). ldap://...:389 only with STARTTLS=true;
# plain unencrypted LDAP is refused.
AD_ESL_URL=ldaps://esl-dc01.esl.example.local:636
# Where users are searched, e.g. DC=esl,DC=local (or a narrower OU=...,DC=...)
AD_ESL_BASE_DN=DC=esl,DC=example,DC=local
# Read-only service account, as a full DN
AD_ESL_BIND_DN=CN=svc_visl_pmo,OU=Service Accounts,DC=esl,DC=example,DC=local
AD_ESL_BIND_PASSWORD=
# Root CA of the ESL domain (PEM / Base-64 .cer), if the DC certificate is
# issued by an internal CA. Path relative to the application folder.
AD_ESL_CA_FILE=certs/esl-root-ca.pem
AD_ESL_UNITS=ESL
AD_ESL_STARTTLS=false

# --- IOB directory (also FACOR) -----------------------------------
AD_IOB_URL=ldaps://iob-dc01.iob.example.local:636
AD_IOB_BASE_DN=DC=iob,DC=example,DC=local
AD_IOB_BIND_DN=CN=svc_visl_pmo,OU=Service Accounts,DC=iob,DC=example,DC=local
AD_IOB_BIND_PASSWORD=
AD_IOB_CA_FILE=certs/iob-root-ca.pem
AD_IOB_UNITS=IOB,FACOR
AD_IOB_STARTTLS=false

# Optional, per directory: AD_<KEY>_USER_FILTER (default matches sAMAccountName),
# AD_<KEY>_UPN_SUFFIX (direct bind when no service account is issued),
# AD_<KEY>_TLS_REJECT_UNAUTHORIZED=false (test only - never in production).
AD_TIMEOUT_MS=10000


# ---------------------------------------------------------------------
# MAIL
# ---------------------------------------------------------------------
# SMTP_ENABLED=false is OUTBOX MODE and it is the safe default.
#
# Every message is rendered in full and written to var/outbox, and NOTHING
# is sent. The Mail outbox screen reads that directory, so the complete
# notification design can be reviewed and signed off by the business before
# a single mail reaches a real employee.
#
# Turn this on only once that review is done.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=25
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=VISL PMO <pmo-noreply@vedanta.co.in>
MAIL_OUTBOX_DIR=var/outbox

# Scheduled mail is OFF by default. A scheduler that starts sending on first
# boot is how a test deployment mails four hundred employees at 07:00.
# Enable only after the outbox has been reviewed.
MAIL_CRON_ENABLED=false
# Daily submission reminders, 09:00
MAIL_REMINDER_CRON=0 9 * * *
# Leadership digest, Monday 07:00
MAIL_DIGEST_CRON=0 7 * * 1


# ---------------------------------------------------------------------
# FINANCIAL YEAR
# ---------------------------------------------------------------------
# Indian financial year: April to March.
# The reporting calendar itself (which month is closed, which is being
# collected) lives in the settings table and is edited in the application
# under System - not here.
FY_START_MONTH=4
FY_START=2026-04-01
FY_LABEL=FY 2026-27
