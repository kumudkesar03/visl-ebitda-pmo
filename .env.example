# =====================================================================
# VISL EBITDA Drive PMO - environment
# Copy to .env and edit. Never commit .env.
# =====================================================================
#
# !! READ THIS BEFORE SETTING ANY PASSWORD !!
#
# dotenv truncates an unquoted value at a '#' character. In the ESL
# deployment this silently shortened the database password and produced a
# "login failed" that looked like wrong credentials for half a day, and
# then did the same thing to the bootstrap admin password.
#
# Keep every secret in this file to letters, digits, hyphen and underscore.
# Avoid  #  $  ;  !  and quote characters entirely.
# =====================================================================

NODE_ENV=development
PORT=4010
APP_URL=http://localhost:4010
APP_NAME=VISL EBITDA Drive PMO


# ---------------------------------------------------------------------
# DATA SOURCE
# ---------------------------------------------------------------------
# synthetic - deterministic in-memory dataset, no database required.
#             Writes are real and persist to var/state.json.
#             Use this for design review and demonstrations.
# mssql     - Azure SQL / SQL Server. Deploy sql/01..04 first.
#
# This is the only line that changes when you connect the database.
DATA_MODE=synthetic


# ---------------------------------------------------------------------
# DATABASE  (required when DATA_MODE=mssql)
# ---------------------------------------------------------------------
DB_HOST=sqldbsrvr1-example.database.windows.net
DB_PORT=1433
DB_NAME=VISL_PMO
DB_USER=visl_app
DB_PASSWORD=change_me_no_hash_or_dollar

# Azure SQL REQUIRES encryption and presents a valid certificate.
# On an on-premise server with a self-signed certificate, invert these.
DB_ENCRYPT=true
DB_TRUST_SERVER_CERT=false

# Serverless Azure tiers auto-pause when idle. The first query after a quiet
# period takes 30-60 seconds to resume, so these are deliberately generous.
# Open the application ~15 minutes before any demonstration.
DB_REQUEST_TIMEOUT_MS=90000
DB_CONNECT_TIMEOUT_MS=60000
DB_POOL_MAX=10


# ---------------------------------------------------------------------
# AUTHENTICATION
# ---------------------------------------------------------------------
# local  - accounts and bcrypt hashes in the users table
# ad     - Active Directory bind
# hybrid - AD first, local as fallback for service accounts
AUTH_MODE=local

# MUST be changed before production. The application refuses to start in
# production with the development default.
JWT_SECRET=dev-only-secret-change-me
SESSION_HOURS=10
COOKIE_NAME=visl_pmo_sid
# Set true once the application is served over HTTPS.
COOKIE_SECURE=false


# ---------------------------------------------------------------------
# ACTIVE DIRECTORY  (AUTH_MODE=ad or hybrid)
# ---------------------------------------------------------------------
# ESL, IOB and FACOR appear to sit behind DIFFERENT directories - the
# tenant shows a separate directory sync account per business. Confirm with
# the AD team before configuring: the answer changes the work materially.
#
# Configuration is therefore keyed by business unit code from the start.
# JSON on one line.
AD_ENABLED=false
# AD_DIRECTORIES={"ESL":{"url":"ldaps://esl-dc:636","baseDN":"DC=esl,DC=local","domainSuffix":"esl.local"},"IOB":{"url":"ldaps://iob-dc:636","baseDN":"DC=iob,DC=local","domainSuffix":"iob.local"}}


# ---------------------------------------------------------------------
# MAIL
# ---------------------------------------------------------------------
# SMTP_ENABLED=false is OUTBOX MODE and it is the safe default.
#
# Every message is rendered in full and written to var/outbox, and NOTHING
# is sent. The Mail outbox screen reads that directory, so the complete
# notification design can be reviewed and signed off by the business before
# a single mail reaches a real employee.
#
# Turn this on only once that review is done.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=25
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=VISL PMO <pmo-noreply@vedanta.co.in>
MAIL_OUTBOX_DIR=var/outbox

# Scheduled mail is OFF by default. A scheduler that starts sending on first
# boot is how a test deployment mails four hundred employees at 07:00.
# Enable only after the outbox has been reviewed.
MAIL_CRON_ENABLED=false
# Daily submission reminders, 09:00
MAIL_REMINDER_CRON=0 9 * * *
# Leadership digest, Monday 07:00
MAIL_DIGEST_CRON=0 7 * * 1


# ---------------------------------------------------------------------
# FINANCIAL YEAR
# ---------------------------------------------------------------------
# Indian financial year: April to March.
# The reporting calendar itself (which month is closed, which is being
# collected) lives in the settings table and is edited in the application
# under System - not here.
FY_START_MONTH=4
FY_START=2026-04-01
FY_LABEL=FY 2026-27
